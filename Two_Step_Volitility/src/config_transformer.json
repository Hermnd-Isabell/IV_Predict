{
    "description": "示例配置：Transformer + MLP",
    "data": {
        "grid_path": "output/spx_step0/daily_grid_154.parquet",
        "raw_path": "data/raw/spx_options.csv",
        "output_step1": "output/spx_step1_transformer",
        "output_step2": "output/spx_step2_transformer"
    },
    "step1": {
        "model_type": "transformer",
        "model_kwargs": {
            "d_model": 64,
            "nhead": 4,
            "num_encoder_layers": 2,
            "dim_feedforward": 128,
            "dropout": 0.1
        },
        "output_activation": "relu",
        "train_kwargs": {
            "epochs": 200,
            "batch_size": 128,
            "lr": 0.001,
            "optimizer": "adam"
        }
    },
    "step2": {
        "model_type": "mlp",
        "model_kwargs": {
            "hidden_dim": 50
        },
        "output_activation": "softplus",
        "train_kwargs": {
            "epochs": 20,
            "batch_size_days": 32,
            "lr": 0.001,
            "lambda_penalty": 1.0,
            "optimizer": "adam"
        }
    }
}
